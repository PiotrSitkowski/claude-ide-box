# Generated by claude-ide-box at proxy start from squid.conf.in. Do not edit.
http_port 3128
pid_filename /run/squid/squid.pid
coredump_dir /tmp

# No caching at all.
cache deny all
cache_mem 0 MB

# Log to the container's stdout/stderr; `claude-ide-box logs` reads them.
access_log stdio:/dev/stdout
cache_log /dev/stderr
cache_store_log none
logfile_rotate 0

# Do not leak anything about the client.
via off
forwarded_for delete
httpd_suppress_version_string on
shutdown_lifetime 1 seconds

acl claude_ide_box_clients src @SUBNET@
acl ssl_port port 443
acl CONNECT method CONNECT
# -n: never reverse-resolve, so a CONNECT to a bare IP address never matches.
acl allowed_domains dstdomain -n "/etc/claude-ide-box/allowlist"

http_access deny !claude_ide_box_clients
http_access deny !CONNECT
http_access deny !ssl_port
http_access allow CONNECT allowed_domains
http_access deny all

# Must stay the last line: entrypoint.sh appends the parent proxy here.
@UPSTREAM@
